        "item_9zdNpB": {
          "type": "item",
          "settings": {
            "title": "Can I get a Sherpa power station in 3-phase?",
            "content": "<p>Yes. The Sherpa PRO MK2 platform supports 3-phase power output as a custom configuration. Use the configurator above to select 3-phase under Mains Output, then submit your spec and we'll confirm availability and lead time.</p>"
